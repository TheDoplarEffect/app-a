<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP only for local/LAN hosts (*arr, Prowlarr). Android NSC has no
     CIDR support — <domain> matches exact IP literals only, so the LAN hosts are
     listed exactly (192.168.178.42 is the hint shown in Settings). Everything
     else (TMDB, Open Library, Jellyfin over TLS) must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">192.168.178.42</domain>
    </domain-config>
</network-security-config>
