<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- LAN services (*arr, Prowlarr) are plain HTTP on 192.168.178.x -->
  <application android:label="app-a" android:allowBackup="true" android:theme="@style/Theme.AppA"
      android:usesCleartextTraffic="true">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name=".DetailActivity" android:exported="false"/>
    <activity android:name=".RequestsActivity" android:exported="false"/>
    <activity android:name=".SettingsActivity" android:exported="false"/>
  </application>
</manifest>
